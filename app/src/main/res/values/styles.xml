<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Interpreter" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/page</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">#1F2F5BEA</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:buttonStyle">@style/Widget.Interpreter.Button</item>
        <item name="android:editTextStyle">@style/Widget.Interpreter.EditText</item>
        <item name="android:spinnerStyle">@style/Widget.Interpreter.Spinner</item>
        <item name="android:alertDialogTheme">@style/Theme.Interpreter.Dialog</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Interpreter" parent="Base.Theme.Interpreter" />

    <style name="Widget.Interpreter.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="Widget.Interpreter.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColorHint">#9AA0B4</item>
    </style>

    <style name="Widget.Interpreter.Spinner" parent="@android:style/Widget.Material.Spinner">
        <item name="android:background">@drawable/spinner_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:popupBackground">@drawable/popup_bg</item>
    </style>

    <style name="Theme.Interpreter.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Interpreter.DialogButton</item>
    </style>

    <style name="Widget.Interpreter.DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>
